{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/client",
    "packages/nanoclaw-channel",
    "packages/openclaw-channel",
    "packages/router",
    "packages/registry"
  ],
  "externalSymbolLinkMappings": {
    "effect": {
      "Effect.die": "https://effect.website/docs",
      "Ref.update": "https://effect.website/docs",
      "HashSet.add": "https://effect.website/docs"
    },
    "@effect/platform": {
      "Socket.SocketError": "https://effect.website/docs"
    }
  },
  "packageOptions": {
    "entryPoints": [
      "src/index.ts"
    ],
    "excludeInternal": true,
    "excludePrivate": true,
    "readme": "none",
    "skipErrorChecking": true,
    "blockTags": [
      "@file",
      "@failure",
      "@param",
      "@returns",
      "@throws",
      "@example",
      "@deprecated",
      "@see",
      "@internal",
      "@module"
    ]
  },
  "outputs": [
    {
      "name": "html",
      "path": "dist/api"
    }
  ],
  "readme": "none",
  "skipErrorChecking": true,
  "logLevel": "Warn"
}
