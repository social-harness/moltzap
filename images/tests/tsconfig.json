{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2024"
    ],
    "customConditions": [
      "sharness-test"
    ]
  },
  "include": [
    "*.ts"
  ]
}
