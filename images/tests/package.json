{
  "name": "@social-harness/image-tests",
  "private": true,
  "type": "module",
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "@moltzap/openclaw-channel": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:"
  },
  "nx": {
    "targets": {
      "test:live": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "node --test --test-timeout=600000 *.live.test.ts"
        },
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "tsc -p tsconfig.json"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "eslint . --max-warnings=0"
        }
      }
    }
  },
  "devDependencies": {
    "@moltzap/registry": "workspace:*",
    "@moltzap/router": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:"
  },
  "files": [
    "package.json"
  ]
}
