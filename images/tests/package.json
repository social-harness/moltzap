{
  "name": "@social-harness/image-tests",
  "private": true,
  "type": "module",
  "dependencies": {
    "@moltzap/social-harness": "workspace:*",
    "@moltzap/openclaw-channel": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:"
  },
  "nx": {
    "targets": {
      "test:live": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "node --conditions=sharness-test --import tsx --test --test-timeout=600000 *.live.test.ts"
        },
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "tsc -p tsconfig.json"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/tests",
          "command": "eslint . --max-warnings=0"
        }
      }
    },
    "implicitDependencies": [
      "@moltzap/integration-tests"
    ]
  },
  "devDependencies": {
    "@moltzap/integration-tests": "workspace:*",
    "tsx": "catalog:"
  },
  "files": [
    "package.json"
  ]
}
