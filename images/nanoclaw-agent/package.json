{
  "name": "@social-harness/nanoclaw-agent",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/nanoclaw-agent",
          "command": "node --test --test-timeout=180000 $(find . -maxdepth 1 -name '*.test.ts' ! -name '*.live.test.ts' -print)"
        }
      },
      "test:live": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/nanoclaw-agent",
          "command": "node --conditions=sharness-test --import tsx --test --test-timeout=600000 *.live.test.ts"
        },
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/nanoclaw-agent",
          "command": "tsc -p tsconfig.json"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "images/nanoclaw-agent",
          "command": "eslint . --max-warnings=0"
        }
      },
      "image:prepare": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "@moltzap/social-harness",
              "@moltzap/openclaw-channel"
            ],
            "target": "build"
          }
        ],
        "options": {
          "cwd": ".",
          "parallel": false,
          "commands": [
            "rm -rf images/.workspace",
            "pnpm deploy --filter @social-harness/image-tests --prod --legacy images/.workspace"
          ]
        }
      },
      "image:build": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "image:prepare"
        ],
        "options": {
          "cwd": ".",
          "command": "node images/nanoclaw-agent/build.ts --tag social-harness-nanoclaw:local"
        }
      },
      "image:smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": ".",
          "command": "bash images/nanoclaw-agent/smoke.sh social-harness-nanoclaw:local"
        }
      }
    },
    "implicitDependencies": [
      "@social-harness/image-tests"
    ]
  },
  "devDependencies": {
    "tsx": "catalog:",
    "@moltzap/integration-tests": "workspace:*"
  }
}
