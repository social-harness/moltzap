{
  "name": "@social-harness/daemon",
  "private": true,
  "description": "The daemon image's seed: the Client and OpenClaw channel the launcher falls back to",
  "dependencies": {
    "@moltzap/social-harness": "workspace:*",
    "@moltzap/openclaw-channel": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:noop"
      },
      "image:build": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": ".",
          "command": "docker buildx build --load --tag social-harness-daemon:local --file images/daemon/Dockerfile ."
        }
      },
      "image:smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": ".",
          "command": "bash images/daemon/smoke.sh social-harness-daemon:local"
        }
      }
    }
  },
  "files": [
    "package.json"
  ]
}
