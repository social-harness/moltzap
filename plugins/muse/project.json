{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@moltzap/muse-plugin",
  "implicitDependencies": ["@moltzap/client"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "plugins/muse",
        "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
      },
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/build/clean-dist.ts"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {"cwd": "plugins/muse", "command": "eslint . --cache --max-warnings=0"}
    },
    "arch:check": {
      "executor": "nx:run-commands",
      "options": {"cwd": "plugins/muse", "command": "node ../../scripts/architecture/check-package.ts ."}
    },
    "typecheck:tests": {
      "executor": "nx:run-commands",
      "options": {"cwd": "plugins/muse", "command": "tsc -p tsconfig.test.json"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"cwd": "plugins/muse", "command": "vitest run"}
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {"cwd": "plugins/muse", "command": "node dist/main.js"}
    }
  }
}
