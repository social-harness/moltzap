{
  "name": "@moltzap/muse-plugin",
  "private": true,
  "type": "module",
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@moltzap/social-harness": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/muse",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/muse",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/muse",
          "command": "safer-architecture-lsp check ."
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/muse",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/muse",
          "command": "vitest run"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "plugins/muse",
          "command": "node dist/main.js"
        }
      }
    }
  }
}
