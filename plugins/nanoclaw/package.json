{
  "name": "@moltzap/nanoclaw-channel",
  "version": "2026.811.0",
  "private": true,
  "description": "NanoClaw channel adapter for Social Harness messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/moltzap.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/channels/sharness.js",
  "types": "./dist/channels/sharness.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/sharness.d.ts",
      "import": "./dist/channels/sharness.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/nanoclaw-channel:build",
    "lint": "nx run @moltzap/nanoclaw-channel:lint",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/nanoclaw",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/nanoclaw",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/nanoclaw",
          "command": "safer-architecture-lsp check ."
        }
      },
      "test:abi": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "plugins/nanoclaw",
          "command": "tsc --noEmit --incremental false --composite false -p tsconfig.json"
        }
      }
    }
  },
  "dependencies": {
    "@moltzap/social-harness": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
