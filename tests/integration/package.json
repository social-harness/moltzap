{
  "name": "@moltzap/integration-tests",
  "private": true,
  "description": "Cross-package process acceptance suites",
  "type": "module",
  "nx": {
    "targets": {
      "test:integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "sources",
          "!{projectRoot}/communication/published-peers.spec.ts",
          "!{projectRoot}/vitest.published.config.ts",
          "!{projectRoot}/images/**",
          "!{projectRoot}/README.md",
          "!{projectRoot}/eslint.config.ts",
          "^production",
          {
            "runtime": "node --version"
          },
          {
            "env": "SHARNESS_EXPERIMENT_HIDE_COLLECTIVES"
          },
          {
            "env": "SHARNESS_EXPERIMENT_HIDE_GROUPS"
          },
          {
            "env": "SHARNESS_MCP_URL"
          },
          {
            "env": "SHARNESS_PG_TEST_URL"
          }
        ],
        "options": {
          "cwd": "tests/integration",
          "command": "vitest run --config vitest.integration.config.ts"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "tests/integration",
          "command": "tsc -p tsconfig.json"
        },
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/eslint.shared.ts",
          "{workspaceRoot}/scripts/**/*.ts",
          "{workspaceRoot}/scripts/tsconfig.json",
          {
            "runtime": "node --version"
          }
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "tests/integration",
          "command": "eslint . --cache --max-warnings=0"
        },
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/eslint.config.ts",
          "{workspaceRoot}/eslint.shared.ts",
          "{workspaceRoot}/knip.json",
          "{workspaceRoot}/tsconfig.eslint.json",
          "{workspaceRoot}/scripts/**/*.ts",
          "{workspaceRoot}/scripts/tsconfig.json",
          {
            "runtime": "node --version"
          }
        ]
      },
      "test:network": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "@moltzap/social-harness:build"
        ],
        "options": {
          "cwd": "tests/integration",
          "command": "tsx documented-network.ts"
        }
      },
      "test:live": {
        "cache": false,
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "tests/integration",
          "command": "node --conditions=sharness-test --import tsx --test --test-timeout=600000 --test-concurrency=1 images/*.spec.ts"
        }
      },
      "test:published": {
        "cache": false,
        "executor": "nx:run-commands",
        "dependsOn": [
          "@moltzap/social-harness:build",
          "@moltzap/registry:build",
          "@moltzap/router:build"
        ],
        "options": {
          "command": "vitest run --config tests/integration/vitest.published.config.ts",
          "cwd": "."
        }
      }
    }
  },
  "devDependencies": {
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@moltzap/openclaw-channel": "workspace:*",
    "@moltzap/registry": "workspace:*",
    "@moltzap/router": "workspace:*",
    "@moltzap/social-harness": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "http-message-signatures": "catalog:",
    "jose": "catalog:",
    "protobufjs": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./process-network": "./process-network-fixture.ts",
    "./daemon-process-harness": "./daemon/daemon-fixture.ts"
  }
}
