{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/build/*.ts",
        "scripts/test-*-package.ts",
        "images/*.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/check-code-links.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/*.spec.ts",
        "scripts/repo/check-agent-files.ts",
        "scripts/repo/check-dependency-versions.ts",
        "scripts/release/read-wire-version.ts"
      ],
      "project": [
        "*.ts",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "@mermaid-js/mermaid-cli",
        "puppeteer"
      ]
    },
    "packages/social-harness": {
      "entry": [
        "src/**/*.spec.ts",
        "src/**/*.types-check.ts",
        "src/launcher/index.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignore": [
        "src/vendor/effect-mcp/**"
      ]
    },
    "plugins/nanoclaw": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp"
      ]
    },
    "plugins/openclaw": {
      "entry": [
        "src/**/*.spec.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp",
        "@modelcontextprotocol/client"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.spec.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/registry": {
      "entry": [
        "src/**/*.spec.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "tests/integration": {
      "entry": [
        "**/*.spec.ts",
        "firewall/firewall-daemon.ts",
        "daemon/launcher-provenance.ts",
        "**/*vitest*.config.ts",
        "images/nanoclaw-probe.ts"
      ],
      "project": [
        "**/*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite-socket"
      ]
    },
    "images/openclaw-agent": {
      "entry": [
        "*.spec.ts",
        "configure-channel.ts",
        "patch-openclaw.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "openclaw"
      ]
    },
    "images/nanoclaw-agent": {
      "entry": [
        "*.spec.ts",
        "entrypoint.ts",
        "install-channel.ts",
        "preload.ts",
        "session-processes.ts"
      ],
      "project": [
        "*.ts"
      ]
    },
    "images/daemon": {
      "ignoreDependencies": [
        "@moltzap/social-harness",
        "@moltzap/openclaw-channel"
      ]
    },
    "plugins/instinct": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp",
        "@modelcontextprotocol/client"
      ]
    },
    "plugins/muse": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp",
        "@modelcontextprotocol/client"
      ]
    },
    "plugins/grokbot": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp",
        "@modelcontextprotocol/client"
      ]
    },
    "plugins/shared": {
      "entry": [
        "*.spec.ts"
      ],
      "project": [
        "*.ts"
      ]
    },
    "plugins/opencode": {
      "entry": [
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/plugin-mcp",
        "@modelcontextprotocol/client"
      ]
    }
  }
}
