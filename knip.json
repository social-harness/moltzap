{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "plugins/*/src/main.ts",
        "plugins/*/src/**/*.test.ts",
        "plugins/*/*.config.ts",
        "scripts/architecture/check-package.ts",
        "scripts/build/*.ts",
        "scripts/code/*.ts",
        "scripts/setup/*.ts",
        "scripts/test-*-package.ts",
        "scripts/test-two-agents-example.ts",
        "examples/*/*.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/generate-constants-snippets.ts",
        "scripts/docs/generate-modules.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts"
      ],
      "project": [
        "plugins/*/**/*.ts",
        "*.ts",
        "scripts/docs/**/*.ts",
        "scripts/architecture/**/*.ts",
        "scripts/build/**/*.ts",
        "scripts/code/**/*.ts",
        "scripts/setup/**/*.ts",
        "scripts/test/packed-workspace.ts",
        "scripts/test-*-package.ts"
      ],
      "ignoreDependencies": [
        "@effect/tsgo",
        "@mermaid-js/mermaid-cli",
        "oxlint",
        "puppeteer"
      ]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "integration/**/*.integration.test.ts",
        "integration/firewall-daemon.ts",
        "src/daemon/launcher/index.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "integration/**/*.ts",
        "*.ts"
      ]
    },
    "packages/nanoclaw-channel": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/identity": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/registry": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    }
  },
  "ignoreIssues": {
    "packages/client/src/communication/conversations/runtime/index.ts": [
      "types"
    ],
    "packages/client/src/communication/conversations/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/records/schemas.ts": [
      "exports"
    ],
    "packages/client/src/communication/records/verification.ts": [
      "exports"
    ],
    "packages/client/src/communication/records/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/store/index.ts": [
      "types"
    ],
    "packages/client/src/communication/store/database/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/store/database/schema.ts": [
      "types"
    ],
    "packages/client/src/communication/store/rows/index.ts": [
      "exports"
    ],
    "packages/client/src/harness/protocol/owner-tools.ts": [
      "exports"
    ]
  }
}
