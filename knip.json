{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/build/*.ts",
        "scripts/test-*-package.ts",
        "images/*.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/check-code-links.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts",
        "scripts/generate-*-golden.ts",
        "scripts/repo/check-agent-files.ts",
        "scripts/repo/check-dependency-versions.ts",
        "scripts/release/wire-version.ts"
      ],
      "project": [
        "*.ts",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "@mermaid-js/mermaid-cli",
        "puppeteer",
        "typedoc"
      ]
    },
    "packages/social-harness": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "src/daemon/launcher/index.ts",
        "vitest*.config.ts",
        "integration/*.integration.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts",
        "integration/*.ts"
      ]
    },
    "plugins/nanoclaw": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "plugins/openclaw": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/registry": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "tests/integration": {
      "entry": [
        "**/*.integration.test.ts",
        "firewall-daemon.ts",
        "launcher-provenance.ts",
        "**/*vitest*.config.ts"
      ],
      "project": [
        "**/*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite-socket"
      ]
    },
    "images/openclaw-agent": {
      "entry": [
        "*.test.ts",
        "configure-channel.ts",
        "patch-openclaw.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "openclaw"
      ]
    },
    "images/nanoclaw-agent": {
      "entry": [
        "*.test.ts",
        "entrypoint.ts",
        "prepare.ts",
        "preload.ts",
        "process-driver.ts",
        "integration-probe.ts"
      ],
      "project": [
        "*.ts"
      ]
    },
    "images/daemon": {
      "ignoreDependencies": [
        "@moltzap/social-harness",
        "@moltzap/openclaw-channel"
      ]
    },
    "images/tests": {
      "entry": [
        "*.test.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/openclaw-channel",
        "@moltzap/social-harness",
        "@modelcontextprotocol/client"
      ]
    },
    "plugins/instinct": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "plugins/muse": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "plugins/grokbot": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    }
  }
}
