{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/build/*.ts",
        "scripts/test-*-package.ts",
        "images/*.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/__tests__/*.test.ts",
        "scripts/__tests__/integration-lint-profile.ts"
      ],
      "project": [
        "*.ts",
        "scripts/docs/**/*.ts",
        "scripts/build/**/*.ts",
        "scripts/test/packed-workspace.ts",
        "scripts/test-*-package.ts",
        "scripts/__tests__/**/*.ts"
      ],
      "ignoreDependencies": [
        "@mermaid-js/mermaid-cli",
        "oxlint",
        "puppeteer",
        "typedoc"
      ]
    },
    "packages/client": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "src/daemon/launcher/index.ts",
        "vitest*.config.ts",
        "integration/*.integration.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts",
        "integration/*.ts"
      ]
    },
    "packages/nanoclaw-channel": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/openclaw-channel": {
      "entry": [
        "src/**/*.test.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/router": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/registry": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.types-check.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "tests/integration": {
      "entry": [
        "**/*.integration.test.ts",
        "firewall-daemon.ts",
        "launcher-provenance.ts",
        "**/*vitest*.config.ts"
      ],
      "project": [
        "**/*.ts"
      ],
      "ignoreDependencies": [
        "@electric-sql/pglite-socket"
      ]
    },
    "images/openclaw-agent": {
      "entry": [
        "*.test.ts",
        "configure-channel.ts",
        "patch-openclaw.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "openclaw"
      ]
    },
    "images/nanoclaw-agent": {
      "entry": [
        "*.test.ts",
        "entrypoint.ts",
        "prepare.ts",
        "preload.ts",
        "process-driver.ts",
        "integration-probe.ts"
      ],
      "project": [
        "*.ts"
      ]
    },
    "images/tests": {
      "entry": [
        "*.test.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "@moltzap/openclaw-channel",
        "@moltzap/registry",
        "@moltzap/router",
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    },
    "plugins/instinct": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "plugins/muse": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    }
  },
  "ignoreIssues": {
    "packages/client/src/communication/conversations/runtime/index.ts": [
      "types"
    ],
    "packages/client/src/communication/conversations/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/records/schemas.ts": [
      "exports"
    ],
    "packages/client/src/communication/records/verification.ts": [
      "exports"
    ],
    "packages/client/src/communication/records/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/store/index.ts": [
      "types"
    ],
    "packages/client/src/communication/store/database/index.ts": [
      "exports",
      "types"
    ],
    "packages/client/src/communication/store/database/schema.ts": [
      "types"
    ],
    "packages/client/src/harness/protocol/owner-tools.ts": [
      "exports"
    ],
    "packages/client/src/communication/store/rows/index.ts": [
      "exports"
    ]
  }
}
