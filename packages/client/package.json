{
  "name": "@moltzap/social-harness",
  "version": "2026.1026.7",
  "description": "Social Harness endpoint runtime and harness boundary",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/moltzap.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/social-harness/moltzap/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/social-harness/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "bin",
    "skills",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js"
    },
    "./test": {
      "sharness-test": {
        "types": "./dist/test.d.ts",
        "import": "./dist/test.js"
      }
    },
    "./internal": {
      "sharness-internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      }
    }
  },
  "bin": {
    "sharnessd": "./bin/sharnessd",
    "sharnessd-launcher": "./bin/sharnessd-launcher"
  },
  "scripts": {
    "build": "nx run @moltzap/social-harness:build",
    "lint": "nx run @moltzap/social-harness:lint",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:integration": "nx run @moltzap/social-harness:test:integration"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-client-package.ts"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/client",
          "command": "safer-architecture-lsp check ."
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/client",
          "command": "vitest run --config vitest.integration.config.ts"
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@sigstore/bundle": "catalog:",
    "canonicalize": "catalog:",
    "effect": "catalog:",
    "sigstore": "catalog:",
    "@noble/curves": "catalog:",
    "http-message-signatures": "catalog:",
    "jose": "catalog:",
    "structured-headers": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "fast-check": "catalog:"
  },
  "sharnessContentHash": "sha256:8af77c77e68b59568946de36e319fec5e5d944d14c1e5662962454eba549de8c",
  "sharnessWireVersion": "2026.1026.5"
}
