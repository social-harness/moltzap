#!/usr/bin/env node
import { Console, Layer } from "effect";
import { installInternalResolution } from "../dist/internal-resolution.js";
import { runRegistryMain } from "../dist/main.js";

installInternalResolution();

const { layer, processHelp } = await import("../dist/server.js");

const program = process.argv.includes("--help")
  ? Console.log(processHelp)
  : Layer.launch(layer);

runRegistryMain(program);
