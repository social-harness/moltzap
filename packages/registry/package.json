{
  "name": "@moltzap/registry",
  "version": "2026.1022.0",
  "description": "Private Registry HTTP process and PostgreSQL persistence",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/moltzap.git",
    "directory": "packages/registry"
  },
  "homepage": "https://github.com/social-harness/moltzap/tree/main/packages/registry#readme",
  "bugs": {
    "url": "https://github.com/social-harness/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "bin",
    "!dist/*.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "sharness-test": {
        "types": "./dist/test.d.ts",
        "import": "./dist/test.js"
      }
    }
  },
  "bin": {
    "sharness-registry": "./bin/sharness-registry"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ],
        "options": {
          "cwd": "packages/registry",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b tsconfig.json tsconfig.test-entry.json"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "options": {
          "cwd": "packages/registry",
          "command": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo -p tsconfig.json"
        }
      },
      "typecheck:tests": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/registry",
          "command": "tsc -p tsconfig.test.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "packages/registry",
          "command": "vitest run --config vitest.config.ts"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/registry",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/registry",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@electric-sql/pglite-socket": "catalog:",
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:",
    "@moltzap/social-harness": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
