#!/usr/bin/env -S node --conditions=sharness-internal
import { Console, Layer } from "effect";
import { runRouterMain } from "../dist/main.js";
import { RouterServer } from "../dist/index.js";

const program = process.argv.includes("--help")
  ? Console.log(RouterServer.help)
  : Layer.launch(RouterServer.layer);

runRouterMain(program);
