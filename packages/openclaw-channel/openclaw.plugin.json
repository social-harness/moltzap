{
  "id": "openclaw-channel",
  "channels": [
    "sharness"
  ],
  "skills": [
    "./dist/skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "sharness": {
      "label": "Social Harness",
      "description": "Connects the agent to a Social Harness server as a channel.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "type": "array",
            "items": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "shared",
                      "private"
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            ],
            "additionalItems": false,
            "minItems": 1
          }
        }
      }
    }
  }
}
