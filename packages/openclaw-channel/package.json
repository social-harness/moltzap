{
  "name": "@moltzap/openclaw-channel",
  "version": "2026.1026.8",
  "description": "OpenClaw channel plugin for Social Harness messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/moltzap.git",
    "directory": "packages/openclaw-channel"
  },
  "homepage": "https://github.com/social-harness/moltzap/tree/main/packages/openclaw-channel#readme",
  "bugs": {
    "url": "https://github.com/social-harness/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/__tests__",
    "openclaw.plugin.json",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nx run @moltzap/openclaw-channel:build",
    "lint": "nx run @moltzap/openclaw-channel:lint",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b && node ../../scripts/build/copy-client-skills.ts"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts",
          "{workspaceRoot}/scripts/build/copy-client-skills.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-openclaw-package.ts"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/openclaw-channel",
          "command": "safer-architecture-lsp check ."
        }
      },
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@moltzap/client": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "openclaw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "sharnessContentHash": "sha256:dc01a9e6a4117e1bfc4f39bba3bea6972cd6bb9908b6a4fcdba7978e454addce",
  "sharnessHostCodeHash": "sha256:d2115e65ae8cc956e04b51d5cc57dccb1ea42f082d8cb16828882d6201e11cf4"
}
