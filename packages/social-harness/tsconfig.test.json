{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "incremental": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "./tsconfig.test.tsbuildinfo",
    "customConditions": [
      "sharness-test"
    ]
  },
  "include": [
    "src/**/*.ts",
    "*.ts",
    "integration/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
