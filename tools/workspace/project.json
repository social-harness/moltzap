{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "targets": {
    "format": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt ."
      }
    },
    "format:check": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt --check ."
      }
    },
    "docs:check:mermaid": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "pnpm exec puppeteer browsers install chrome-headless-shell",
          "node scripts/docs/check-mermaid.ts"
        ]
      }
    },
    "lint:typescript": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tsconfig.eslint.json",
          "tsc --noEmit -p scripts/tsconfig.json"
        ]
      }
    },
    "lint:dead-code": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "agent-code-guard-knip --treat-config-hints-as-errors"
      }
    },
    "lint:eslint": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/eslint.shared.ts",
        "{workspaceRoot}/tsconfig.eslint.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/*.ts",
        "{workspaceRoot}/images/**/*.ts",
        "{workspaceRoot}/scripts/**/*.ts",
        "{workspaceRoot}/scripts/tsconfig.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "eslint '*.ts' 'images/**/*.ts' 'scripts/**/*.ts' --no-error-on-unmatched-pattern --cache --max-warnings=0"
      }
    },
    "lint:oxlint": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxlint . --deny-warnings"
      }
    },
    "lint:script-reachability": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/repo/check-script-reachability.ts"
      }
    },
    "lint:root": {
      "cache": false,
      "dependsOn": [
        "lint:typescript",
        "lint:dead-code",
        "lint:eslint"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint": {
      "cache": false,
      "dependsOn": [
        "lint:root",
        "lint:oxlint",
        "lint:script-reachability",
        "lint:agent-files",
        "lint:dependency-versions",
        {
          "target": "arch:check",
          "projects": "@moltzap/*"
        },
        {
          "target": "lint",
          "projects": "@moltzap/*"
        },
        {
          "target": "lint",
          "projects": "@social-harness/*"
        },
        {
          "target": "typecheck",
          "projects": "@social-harness/*"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint:dependency-versions": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/repo/check-dependency-versions.ts"
      }
    },
    "lint:agent-files": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/repo/check-agent-files.ts"
      }
    },
    "test": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/docs/**/*.ts",
        "{workspaceRoot}/scripts/docs/mermaid-puppeteer.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec vitest run --config scripts/docs/vitest.config.ts"
      }
    },
    "test:image-input-key": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/release/**/*.ts",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/plugins/**/*",
        "{workspaceRoot}/images/**/*",
        "{workspaceRoot}/scripts/build/**/*",
        "{workspaceRoot}/scripts/setup/**/*",
        "{workspaceRoot}/.node-version",
        "{workspaceRoot}/.npmrc",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/nx.json",
        "sharedGlobals",
        {
          "runtime": "node --version"
        },
        "{workspaceRoot}/eslint.shared.ts",
        "{workspaceRoot}/.pnpmfile.cjs",
        "{workspaceRoot}/tools/**/*",
        "{workspaceRoot}/tsconfig*.json"
      ],
      "options": {
        "command": "node scripts/release/image-input-key.test.ts"
      }
    },
    "docs:api": {
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "@moltzap/social-harness",
            "@moltzap/registry",
            "@moltzap/router",
            "@moltzap/openclaw-channel",
            "@moltzap/nanoclaw-channel"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/typedoc.json",
        "{workspaceRoot}/tsconfig*.json",
        "{workspaceRoot}/packages/**/*.ts",
        "{workspaceRoot}/packages/**/*.json",
        "sharedGlobals",
        "{workspaceRoot}/plugins/**/*.ts",
        "{workspaceRoot}/plugins/**/*.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/api"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec typedoc"
      }
    }
  }
}
