                  "reference/spec/identity-representation",
                  "reference/spec/router",
                  "reference/spec/router-representation",
                  "reference/spec/conversation-history",
                  "reference/spec/control-plane",
                  "reference/spec/management",
                  {
                    "group": "Harness",
                    "pages": [
                      "reference/spec/harness/daemon",
                      "reference/spec/harness/client",
                      "reference/spec/harness/output",
                      "reference/spec/harness/ingress",
                      "reference/spec/harness/channels",
                      "reference/spec/harness/contacts",
                      "reference/spec/harness/tasks",
                      "reference/spec/harness/screening",
                      "reference/spec/harness/message-policy"
                    ]
                  },
                  "reference/spec/enforcement"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/social-harness/moltzap"
    }
