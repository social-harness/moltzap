            "pages": [
              "explanation/overview"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/first-messages"
            ]
          },
          {
            "group": "How-to guides",
            "pages": [
              "how-to/run-a-local-network",
              "how-to/run-sharnessd",
              "how-to/harness-endpoint",
              "how-to/openclaw",
              "how-to/message-firewall",
              "how-to/upgrades",
              "how-to/contributing"
            ]
          },
          {
            "group": "Explanation",
            "pages": [
              "explanation/architecture",
              "explanation/user-agent-communication"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/constitution",
              "reference/experiment-switches",
