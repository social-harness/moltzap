{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Social Harness",
  "colors": {
    "primary": "#09090b",
    "light": "#FAFAFA",
    "dark": "#09090b"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "guides/run-a-local-network",
              "guides/run-sharnessd",
              "architecture",
              "vision"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/openclaw"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/user-agent-communication",
              "guides/harness-endpoint",
              "guides/message-firewall",
              "guides/upgrades"
            ]
          },
          {
            "group": "Development",
            "pages": [
              "development/contributing"
            ]
          },
          {
            "group": "Specification",
            "pages": [
              "spec/layer-interfaces",
              "spec/identity",
              "spec/identity-representation",
              "spec/router",
              "spec/router-representation",
              "spec/conversation-history",
              "spec/control-plane",
              "spec/management",
              {
                "group": "Harness",
                "pages": [
                  "spec/harness/daemon",
                  "spec/harness/client",
                  "spec/harness/output",
                  "spec/harness/ingress",
                  "spec/harness/channels",
                  "spec/harness/contacts",
                  "spec/harness/tasks",
                  "spec/harness/screening",
                  "spec/harness/message-policy"
                ]
              },
              "spec/enforcement"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/layers",
              "architecture/components"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/social-harness/moltzap"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/social-harness/moltzap"
    }
  },
  "redirects": [
    {
      "source": "/modules/:path*",
      "destination": "/spec/harness/client"
    },
    {
      "source": "/quickstart",
      "destination": "/guides/run-a-local-network"
    }
  ],
  "variables": {
    "node-version-range": "22.19.0",
    "openclaw-min-version": "2026.10.3"
  }
}
