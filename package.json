{
  "name": "moltzap",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.6.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test:integration",
    "lint": "pnpm nx run workspace:lint",
    "arch:check": "NODE_OPTIONS=--max-old-space-size=8192 nx run-many -t arch:check",
    "arch:config:generate": "node scripts/architecture/gen-configs.ts",
    "arch:config:check": "pnpm arch:config:generate && test -z \"$(git ls-files --others --exclude-standard -- 'packages/*/safer-architecture.config.json')\" && git diff --exit-code -- 'packages/*/safer-architecture.config.json'",
    "lint:root": "tsc --noEmit -p tsconfig.eslint.json && agent-code-guard-knip --treat-config-hints-as-errors && eslint . --cache --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "nx run-many -t build && nx run-many -t typecheck",
    "check": "pnpm lint && pnpm format:check",
    "docs:dev": "cd docs && mint dev --no-open",
    "docs:open": "cd docs && mint dev",
    "docs:generate": "pnpm nx run workspace:docs:generate",
    "docs:check": "cd docs && mint broken-links",
    "docs:check:drift": "pnpm docs:generate && test -z \"$(git ls-files --others --exclude-standard -- 'docs/modules/**' 'packages/**/MODULE.md')\" && git diff --exit-code docs/ 'packages/**/MODULE.md' README.md && pnpm docs:check:no-hardcoded-constants && pnpm docs:check:doc-imports-resolve",
    "docs:check:mermaid": "pnpm nx run workspace:docs:check:mermaid",
    "docs:check:no-hardcoded-constants": "node scripts/docs/check-no-hardcoded-constants.ts",
    "docs:check:doc-imports-resolve": "node scripts/docs/check-doc-imports-resolve.ts",
    "docs:check:gates-test": "node scripts/__tests__/gates.test.ts",
    "docs:test": "pnpm nx run workspace:test",
    "test:compute-next-version": "bash scripts/release/compute-next-version.test.sh",
    "test:npm-version-exists": "bash scripts/release/npm-version-exists.test.sh",
    "test:ghcr-digest": "bash scripts/release/ghcr-digest.test.sh",
    "image:keys": "node scripts/release/image-input-key.ts",
    "test:image-input-key": "pnpm nx run workspace:test:image-input-key",
    "test:select-packages": "node scripts/release/select-packages.test.ts",
    "test:client-host-imports": "node scripts/test/client-host-imports.test.ts",
    "prepare": "husky && node scripts/setup/restore-tsgo-exec-bit.ts",
    "effect:source": "./scripts/setup/prepare-effect.sh",
    "test:affected": "nx affected -t test"
  },
  "devDependencies": {
    "@chughtapan/safer-architecture-lsp": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@mermaid-js/mermaid-cli": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@moltzap/client": "workspace:*",
    "@types/estree": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-agent-code-guard": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "mint": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "puppeteer": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
