{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/src/**/__tests__/**",
      "!{projectRoot}/tsconfig.test.json",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.integration.config.ts",
      "!{projectRoot}/**/MODULE.md",
      "!{projectRoot}/safer-architecture.config.json"
    ],
    "sources": [
      "default",
      "!{projectRoot}/**/MODULE.md",
      "!{projectRoot}/safer-architecture.config.json"
    ],
    "workspaceFiles": [
      "{workspaceRoot}/**/*"
    ],
    "docsGeneration": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/typedoc.json",
      "{workspaceRoot}/scripts/docs/generate-constants-snippets.ts",
      "{workspaceRoot}/scripts/docs/generate-modules.ts",
      "{workspaceRoot}/scripts/docs/flow-coverage.ts",
      "{workspaceRoot}/scripts/docs/mintlify-nav.ts",
      "{workspaceRoot}/scripts/docs/modules.ts",
      "{workspaceRoot}/scripts/docs/signature-extract.ts",
      "{workspaceRoot}/scripts/docs/sharness-version.ts",
      "{workspaceRoot}/scripts/docs/typedoc-load.ts",
      "{workspaceRoot}/packages/**/*.json",
      "{workspaceRoot}/packages/**/*.ts",
      "!{workspaceRoot}/packages/**/*.test.ts",
      "!{workspaceRoot}/packages/**/src/__tests__/**/*",
      "!{workspaceRoot}/packages/**/dist/**/*",
      "!{workspaceRoot}/packages/**/src/**/MODULE.md",
      "{workspaceRoot}/docs/**/*",
      "!{workspaceRoot}/docs/modules/**/*",
      "!{workspaceRoot}/docs/snippets/constants/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/package.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.typecheck.tsbuildinfo"
      ],
      "cache": true
    },
    "typecheck:tests": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.shared.ts"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.test.tsbuildinfo"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "sources",
        "^production"
      ],
      "cache": true
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "sources",
        "^production",
        {
          "runtime": "node --version"
        }
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/eslint.shared.ts",
        "{workspaceRoot}/knip.json",
        "{workspaceRoot}/oxlint.json",
        "{workspaceRoot}/tsconfig.eslint.json"
      ],
      "cache": true
    },
    "arch:check": {
      "dependsOn": [
        {
          "target": "arch:config:generate",
          "projects": "workspace"
        }
      ],
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      },
      "inputs": [
        "default",
        "{projectRoot}/safer-architecture.config.json",
        "{workspaceRoot}/scripts/architecture/check-package.ts"
      ],
      "cache": true
    }
  },
  "defaultBase": "main",
  "analytics": false
}
