{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/src/**/__tests__/**",
      "!{projectRoot}/tsconfig.test.json",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.integration.config.ts",
      "!{projectRoot}/safer-architecture.config.json"
    ],
    "sources": [
      "default",
      "!{projectRoot}/safer-architecture.config.json"
    ],
    "workspaceFiles": [
      "{workspaceRoot}/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/package.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.typecheck.tsbuildinfo"
      ],
      "cache": true
    },
    "typecheck:tests": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.shared.ts"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.test.tsbuildinfo"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "sources",
        "^production"
      ],
      "cache": true
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "sources",
        "^production",
        {
          "runtime": "node --version"
        }
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/eslint.shared.ts",
        "{workspaceRoot}/knip.json",
        "{workspaceRoot}/tsconfig.eslint.json"
      ],
      "cache": true
    },
    "arch:check": {
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      },
      "inputs": [
        "default",
        "{projectRoot}/safer-architecture.config.json"
      ],
      "cache": true
    }
  },
  "defaultBase": "main",
  "analytics": false
}
